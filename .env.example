APP_NAME=secure-chat-backend
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=*
TRUSTED_HOSTS=localhost,127.0.0.1,10.0.2.2,api

POSTGRES_DB=chatdb
POSTGRES_USER=chatuser
POSTGRES_PASSWORD=chatpass
DATABASE_URL=postgresql+psycopg://chatuser:chatpass@postgres:5432/chatdb

REDIS_URL=redis://redis:6379/0

RABBITMQ_DEFAULT_USER=chatmq
RABBITMQ_DEFAULT_PASS=chatmqpass
RABBITMQ_URL=amqp://chatmq:chatmqpass@rabbitmq:5672//

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_ATTACHMENTS=chat-attachments-dev
MINIO_BUCKET_TEMP=chat-temp-uploads-dev
MINIO_BUCKET_ASSETS=chat-assets-dev

JWT_SECRET_KEY=change-me-super-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
BOOTSTRAP_TOKEN_EXPIRE_MINUTES=15

EMAIL_CODE_EXPIRE_MINUTES=10
EMAIL_CODE_MAX_ATTEMPTS=5
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_MINUTES=30
ALLOW_DEBUG_EMAIL_CODES=false

PRESIGNED_DOWNLOAD_EXPIRE_SECONDS=300
PRESIGNED_UPLOAD_EXPIRE_SECONDS=900
AVATAR_MAX_BYTES=5242880
APK_MAX_BYTES=268435456
APK_UPLOAD_TOKEN=change-me-apk-upload-token
FCM_NOTIFICATION_TTL_SECONDS=300

FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=secure-chat-backend@dev
