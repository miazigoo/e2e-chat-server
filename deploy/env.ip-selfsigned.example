APP_NAME=secure-chat-backend
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# Native Android client does not rely on browser CORS, but production config
# cannot use '*', so keep the server IP here.
BACKEND_CORS_ORIGINS=https://<SERVER_IP>

POSTGRES_DB=chatdb
POSTGRES_USER=chatuser
POSTGRES_PASSWORD=CHANGE_ME_STRONG
DATABASE_URL=postgresql+psycopg://chatuser:CHANGE_ME_STRONG@postgres:5432/chatdb

REDIS_URL=redis://redis:6379/0

RABBITMQ_DEFAULT_USER=chatmq
RABBITMQ_DEFAULT_PASS=CHANGE_ME_STRONG
RABBITMQ_URL=amqp://chatmq:CHANGE_ME_STRONG@rabbitmq:5672//

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=<SERVER_IP>:9443
MINIO_PUBLIC_SECURE=true
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_STRONG
MINIO_BUCKET_ATTACHMENTS=chat-attachments-prod
MINIO_BUCKET_TEMP=chat-temp-uploads-prod
MINIO_BUCKET_ASSETS=chat-assets-prod

JWT_SECRET_KEY=CHANGE_ME_SUPER_SECRET_KEY_AT_LEAST_32_CHARS_LONG
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

EMAIL_CODE_EXPIRE_MINUTES=10
LOGIN_MAX_FAILED_ATTEMPTS=5
EMAIL_CODE_MAX_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_MINUTES=30

# From your Firebase project config.
FCM_PROJECT_ID=androidchat-9e354
# Container path for Firebase Admin SDK service account JSON.
FCM_CREDENTIALS_PATH=/run/secrets/fcm_service_account.json

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=secure-chat-backend

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG

# Self-signed IP-only TLS mode.
SERVER_IP=<SERVER_IP>
CADDY_HTTP_BIND=127.0.0.1:80
CADDY_HTTPS_BIND=443
CADDY_STORAGE_HTTPS_BIND=9443
CADDY_STORAGE_SITE=<SERVER_IP>:9443
CADDY_CONFIG=Caddyfile.ip-selfsigned

# Trusted host validation must include the external IP.
TRUSTED_HOSTS=<SERVER_IP>,localhost,127.0.0.1,api

# Optional bug tracker
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=secure-chat-backend@1.0.0

BOOTSTRAP_TOKEN_EXPIRE_MINUTES=15

PRESIGNED_DOWNLOAD_EXPIRE_SECONDS=300
PRESIGNED_UPLOAD_EXPIRE_SECONDS=900
AVATAR_MAX_BYTES=5242880
APK_MAX_BYTES=268435456
APK_UPLOAD_TOKEN=CHANGE_ME_APK_UPLOAD_TOKEN
FCM_NOTIFICATION_TTL_SECONDS=300
